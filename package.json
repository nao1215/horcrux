{
  "name": "@nao1215/horcrux",
  "version": "0.0.3",
  "description": "A TypeScript library for splitting files into encrypted fragments (horcruxes) inspired by Harry Potter",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core/split": {
      "types": "./dist/core/split.d.ts",
      "default": "./dist/core/split.js"
    },
    "./core/bind": {
      "types": "./dist/core/bind.d.ts",
      "default": "./dist/core/bind.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node/index.d.ts",
      "default": "./dist/adapters/node/index.js"
    },
    "./adapters/react-native": {
      "types": "./dist/adapters/react-native/index.d.ts",
      "default": "./dist/adapters/react-native/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core/split": [
        "dist/core/split.d.ts"
      ],
      "core/bind": [
        "dist/core/bind.d.ts"
      ],
      "adapters/node": [
        "dist/adapters/node/index.d.ts"
      ],
      "adapters/react-native": [
        "dist/adapters/react-native/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format:check": "prettier --check \"src/**/*.ts\" test/react-native-adapter.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "test:react-native": "jest --runTestsByPath test/react-native-adapter.test.ts",
    "test:package": "npm run clean && npm run build && node scripts/package_smoke.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nao1215/horcrux.git"
  },
  "keywords": [
    "horcrux",
    "file-splitting",
    "shamir-secret-sharing",
    "encryption",
    "typescript",
    "nodejs",
    "react-native",
    "backup",
    "crypto"
  ],
  "author": "Naohiro CHIKAMATSU <n.chika156@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nao1215/horcrux/issues"
  },
  "homepage": "https://github.com/nao1215/horcrux#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "fast-check": "^4.10.3",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "stream": "^0.0.3"
  },
  "overrides": {
    "ajv": "^6.14.0",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
